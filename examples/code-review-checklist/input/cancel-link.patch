@@ -0,0 +1,31 @@
+import logging
+import random
+
+from flask import Blueprint, abort, render_template_string
+
+from ..db import get_db
+
+bp = Blueprint("cancel", __name__)
+log = logging.getLogger(__name__)
+
+CANCELLED_PAGE = "<h1>Your appointment has been cancelled</h1><p>We hope to see you soon.</p>"
+
+
+def create_cancel_token(appointment_id: int) -> str:
+    token = str(int(random.random() * 10**12))
+    db = get_db()
+    db.execute("INSERT INTO cancel_tokens (token, appointment_id) VALUES (?, ?)", (token, appointment_id))
+    db.commit()
+    log.info("created cancel token %s for appointment %s", token, appointment_id)
+    return token
+
+
+@bp.get("/c/<token>")
+def cancel_by_link(token: str):
+    db = get_db()
+    row = db.execute(f"SELECT appointment_id FROM cancel_tokens WHERE token = '{token}'").fetchone()
+    if row is None:
+        abort(404)
+    db.execute("UPDATE appointments SET status = 'cancelled' WHERE id = ?", (row["appointment_id"],))
+    db.commit()
+    return render_template_string(CANCELLED_PAGE)
