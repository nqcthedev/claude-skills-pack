+"""Send day-before SMS reminders. Run from cron at 18:00 every day."""
+from datetime import date, timedelta
+
+import requests
+
+from . import config
+from .db import get_db
+from .routes.cancel import create_cancel_token
+
+
+def send_sms(phone: str, text: str) -> None:
+    requests.post(config.SMS_API_URL, json={"to": phone, "from": config.SMS_SENDER, "text": text}, headers={"Authorization": f"Bearer {config.SMS_API_KEY}"})
+
+
+def send_reminders() -> int:
+    db = get_db()
+    tomorrow = (date.today() + timedelta(days=1)).isoformat()
+    appointments = db.execute("SELECT * FROM appointments WHERE starts_at LIKE ?", (tomorrow + "%",)).fetchall()
+    sent = 0
+    for appt in appointments:
+        patient = db.execute("SELECT * FROM patients WHERE phone = ?", (appt["patient_phone"],)).fetchone()
+        token = create_cancel_token(appt["id"])
+        link = f"{config.PUBLIC_BASE_URL}/c/{token}"
+        if patient and patient["language"] == "en":
+            text = f"Reminder: your BrightSmile appointment is tomorrow at {appt['starts_at'][11:16]}. Can't come? Cancel: {link}"
+        else:
+            text = f"Nhac lich: ban co lich hen BrightSmile ngay mai luc {appt['starts_at'][11:16]}. Huy lich: {link}"
+        print("sending", appt["patient_phone"], text)
+        send_sms(appt["patient_phone"], text)
+        sent += 1
+    return sent
